# ─── Supabase (projeto EXCLUSIVO deste restaurante) ──────────────────────────
SUPA_URL=https://XXXXXXXXXXXX.supabase.co
SUPA_SERVICE_KEY=eyJ...service_role...

# ─── OpenAI (GPT-4o agente + Whisper áudio + Vision imagem) ──────────────────
OPENAI_API_KEY=sk-proj-XXXXXXXXXXXX

# ─── Evolution API (WhatsApp) ────────────────────────────────────────────────
EVOLUTION_URL=https://sua-evolution.easypanel.host
EVOLUTION_KEY=XXXXXXXXXXXX
EVOLUTION_INSTANCE=nome-da-instancia

# ─── Allowlist (opcional) ─────────────────────────────────────────────────────
# Vazio = atende todo mundo. Com números (separados por vírgula), só eles são
# atendidos e os demais são ignorados em silêncio — útil quando o chip também
# recebe contatos que não devem falar com o agente.
TELEFONES_PERMITIDOS=

# ─── Servidor ─────────────────────────────────────────────────────────────────
PORT=3000
